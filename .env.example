# ─────────────────────────────────────────────────────────────────────────────
#  Marquee settings — edit the folder paths below, then save this file.
#  Windows paths: use forward slashes, e.g.  D:/Movies   or   C:/Users/you/Videos
#  Spaces are fine, e.g.  E:/Media/TV Shows   (no quotes needed)
# ─────────────────────────────────────────────────────────────────────────────

# Your movie folder
MOVIES_DIR=./media/movies

# More movie folders, e.g. on other drives. They all appear together in the
# "Movies" library. Remove the # at the start of a line to use it.
#MOVIES_DIR_2=E:/Movies
#MOVIES_DIR_3=F:/More Movies
#MOVIES_DIR_4=G:/Films

# Your TV show folder (Show Name/Season 01/Show Name - S01E01.mkv)
TV_DIR=./media/tv

# More TV folders on other drives (same idea as above)
#TV_DIR_2=E:/TV Shows
#TV_DIR_3=
#TV_DIR_4=

# Where downloaded YouTube videos are saved
YOUTUBE_DIR=./media/youtube

# Port for the web interface: http://localhost:32500
MARQUEE_PORT=32500

# Your time zone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York

# Optional: TMDB API key for movie posters, summaries and ratings. It's easier to paste it in
# the web interface instead (Settings → Metadata). TV shows also work without it, via TVmaze.
TMDB_API_KEY=

# Minutes between automatic library rescans (0 = only scan manually)
SCAN_INTERVAL=30

# Where backups are saved (a folder on this PC). Automatic backups run nightly; change the
# time and how many to keep in Settings -> Backups.
BACKUP_DIR=./backups

# ---- Video conversion and casting (optional) -----------------------------------------
# Use a graphics card to convert videos the browser can't play directly (much faster than the
# CPU, and several people can watch at once). Leave empty for CPU only.
#   nvidia      - an NVIDIA card (Windows with Docker Desktop, or Linux with the NVIDIA Container Toolkit)
#   intel / amd - built-in Intel or AMD graphics (Linux hosts only)
# Then run start-marquee.bat again. Settings -> Transcoding shows whether it worked.
GPU=
# Linux with GPU=intel/amd: the number of the "render" group (run: getent group render)
#RENDER_GID=105

# Address Chromecasts and TVs use to reach Marquee. Filled in automatically with this PC's
# network address; set it if casting doesn't start, e.g. http://192.168.1.20:32500
CAST_URL=

# ---- Watching away from home (optional) -------------------------------------------------
# Option A - Tailscale (free, recommended). Private to your own devices: install the Tailscale
# app on your phone/laptop and sign in with the same account.
#   1. Create a free account at https://tailscale.com and, in the admin console, turn on
#      DNS -> "HTTPS Certificates".
#   2. Create an auth key at https://login.tailscale.com/admin/settings/keys and paste it here.
#   3. Run start-marquee.bat. Marquee appears at https://marquee.<your-tailnet>.ts.net
TS_AUTHKEY=
# Name in your tailnet (the first part of the address).
TS_HOSTNAME=marquee
# Set to true to also let people WITHOUT Tailscale open that address (Tailscale Funnel).
# Anyone on the internet could then reach your sign-in page.
TAILSCALE_PUBLIC=

# Option B - Cloudflare Tunnel (needs a domain on Cloudflare). In Cloudflare Zero Trust,
# create a tunnel, add a public hostname pointing to http://marquee:32500, and paste its token:
CLOUDFLARE_TUNNEL_TOKEN=
