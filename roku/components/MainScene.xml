<?xml version="1.0" encoding="utf-8"?>
<!-- Holds the screens as a stack: a screen asks for another by setting its `navigate` field, and
     Back returns to the one before. -->
<component name="MainScene" extends="Scene">
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0B0B0BFF" />
    <Group id="screens" />
  </children>
  <script type="text/brightscript" uri="MainScene.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
