<?xml version="1.0" encoding="utf-8"?>
<!-- A wide card: the artwork with the title on it, progress, and unwatched episodes. -->
<component name="CardItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="onSize" />
    <field id="height" type="float" onChange="onSize" />
  </interface>
  <children>
    <Rectangle id="bg" color="0x242424FF" />
    <Label id="initial" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="72" /></Label>
    <Poster id="art" loadDisplayMode="scaleToZoom" />
    <Poster id="scrim" uri="pkg:/images/card_scrim.png" />
    <Label id="title" color="0xFFFFFFFF" wrap="true" maxLines="2" vertAlign="bottom">
      <Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="26" />
    </Label>
    <Rectangle id="track" color="0x787878C0" height="6" visible="false" />
    <Rectangle id="bar" color="0xE31B23FF" height="6" visible="false" />
    <Rectangle id="badgeBg" color="0xE31B23FF" width="40" height="34" visible="false" />
    <Label id="badge" color="0xFFFFFFFF" width="40" height="34" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" visible="false" />
  </children>
  <script type="text/brightscript" uri="CardItem.brs" />
</component>
