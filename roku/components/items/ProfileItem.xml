<?xml version="1.0" encoding="utf-8"?>
<!-- A profile on "Who's watching?": its coloured square with the initial, and the name below.
     The highlighted one gets a white frame. -->
<component name="ProfileItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="gridHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <children>
    <Rectangle id="frame" translation="[-8,-8]" width="256" height="256" color="0xFFFFFFFF" visible="false" />
    <Rectangle id="square" width="240" height="240" />
    <Label id="initial" width="240" height="240" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
      <Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="110" />
    </Label>
    <Rectangle id="kidsBg" translation="[12,196]" width="84" height="32" color="0xFFFFFFFF" visible="false" />
    <Label id="kids" text="KIDS" translation="[12,196]" width="84" height="32" horizAlign="center" vertAlign="center" color="0x000000FF" font="font:SmallestBoldSystemFont" visible="false" />
    <Label id="lock" text="PIN" translation="[176,12]" width="52" height="30" horizAlign="center" vertAlign="center" color="0xFFFFFFCC" font="font:SmallestBoldSystemFont" visible="false" />
    <Label id="name" translation="[-30,262]" width="300" horizAlign="center" color="0xA8A8A8FF" font="font:MediumSystemFont" />
  </children>
  <script type="text/brightscript" uri="ProfileItem.brs" />
</component>
