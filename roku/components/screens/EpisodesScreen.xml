<?xml version="1.0" encoding="utf-8"?>
<!-- A show's episodes: seasons on the left, that season's episodes on the right. -->
<component name="EpisodesScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" onChange="onRefresh" />
  </interface>
  <children>
    <Label id="title" translation="[96,60]" width="1700" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <LabelList id="seasons" translation="[96,190]" itemSize="[380,70]" color="0xCFCFCFFF" focusedColor="0x000000FF" focusBitmapUri="pkg:/images/white.png"
      font="font:MediumBoldSystemFont" focusedFont="font:MediumBoldSystemFont" />
    <MarkupList id="episodes" translation="[520,180]" itemComponentName="EpisodeItem" itemSize="[1300,200]" itemSpacing="[0,16]" numRows="4"
      vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
  </children>
  <script type="text/brightscript" uri="EpisodesScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
