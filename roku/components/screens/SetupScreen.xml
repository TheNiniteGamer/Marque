<?xml version="1.0" encoding="utf-8"?>
<!-- First start: find the Marquee server on the network, or type its address. -->
<component name="SetupScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" />
  </interface>
  <children>
    <Label text="MARQUEE" translation="[120,90]" color="0xE31B23FF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <Label text="Find your Marquee server" translation="[120,230]" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="52" /></Label>
    <Label id="status" translation="[120,320]" width="1400" wrap="true" color="0xA8A8A8FF" font="font:MediumSystemFont" text="Looking for Marquee on your network… (this can take half a minute)" />
    <LabelList id="list" translation="[120,420]" itemSize="[1000,76]" color="0xD0D0D0FF" focusedColor="0x000000FF" focusBitmapUri="pkg:/images/white.png" font="font:MediumBoldSystemFont" focusedFont="font:MediumBoldSystemFont" />
  </children>
  <script type="text/brightscript" uri="SetupScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
