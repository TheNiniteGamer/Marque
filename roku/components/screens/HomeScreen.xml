<?xml version="1.0" encoding="utf-8"?>
<!-- Home: the top shows the featured title (or the one highlighted in the rows) on its artwork,
     with rows of titles below, and the bar along the top (TopBar) as in the other apps. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" onChange="onRefresh" />
  </interface>
  <children>
    <Poster id="backdrop" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToZoom" />
    <Poster uri="pkg:/images/fade_left.png" width="1920" height="1080" />
    <Poster uri="pkg:/images/fade_bottom.png" translation="[0,560]" width="1920" height="520" />
    <TopBar id="topBar" current="home" />
    <LayoutGroup id="info" translation="[96,150]" itemSpacings="[10,18,12]">
      <Label id="kind" color="0xE6E6E6FF" font="font:SmallBoldSystemFont" />
      <Label id="title" width="1050" wrap="true" maxLines="2" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="72" /></Label>
      <Label id="meta" width="1050" color="0xDEDEDEFF" font="font:MediumBoldSystemFont" />
      <Label id="overview" width="900" wrap="true" maxLines="2" color="0xE6E6E6FF" font="font:MediumSystemFont" />
    </LayoutGroup>
    <!-- Play / More info, side by side: left and right move between them (the HomeScreen handles the keys). -->
    <LayoutGroup id="heroButtons" translation="[96,564]" layoutDirection="horiz" itemSpacings="[20]" focusable="true">
      <Group id="hb0"><Rectangle id="hbBg0" height="72" /><Label id="hbText0" translation="[40,0]" height="72" vertAlign="center" font="font:MediumBoldSystemFont" /></Group>
      <Group id="hb1"><Rectangle id="hbBg1" height="72" /><Label id="hbText1" translation="[40,0]" height="72" vertAlign="center" font="font:MediumBoldSystemFont" /></Group>
    </LayoutGroup>
    <RowList id="rows" translation="[96,680]" itemComponentName="CardItem" itemSize="[1824,280]" numRows="2" itemSpacing="[0,30]"
      rowItemSize="[[384,216]]" rowItemSpacing="[[16,0]]" showRowLabel="[true]" rowLabelOffset="[[0,14]]" rowLabelColor="0xFFFFFFFF"
      rowLabelFont="font:MediumBoldSystemFont" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus" drawFocusFeedback="true" />
    <Label id="status" translation="[96,700]" width="1600" wrap="true" color="0xA8A8A8FF" font="font:MediumSystemFont" />
    <OptionsMenu id="menu" />
  </children>
  <script type="text/brightscript" uri="HomeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
