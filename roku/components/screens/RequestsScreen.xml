<?xml version="1.0" encoding="utf-8"?>
<!-- My requests (as on the web): what you asked for and how it's getting on; choosing one that's
     here opens it, ✱ withdraws one still waiting. New requests start from Search ("Ask for it"). -->
<component name="RequestsScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" alwaysNotify="true" onChange="onRefresh" />
  </interface>
  <children>
    <Label text="My requests" translation="[96,60]" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <Label id="status" translation="[96,150]" width="1700" wrap="true" maxLines="2" color="0xA8A8A8FF" font="font:MediumSystemFont" />
    <MarkupList id="list" translation="[96,250]" itemComponentName="EpisodeItem" itemSize="[1300,200]" itemSpacing="[0,16]" numRows="4"
      vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
    <OptionsMenu id="menu" />
  </children>
  <script type="text/brightscript" uri="RequestsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
