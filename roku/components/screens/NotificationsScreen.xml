<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications (the bell, as on the web): new episodes of your shows, requests that are here.
     Choosing one opens what it's about. -->
<component name="NotificationsScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" />
  </interface>
  <children>
    <Label text="Notifications" translation="[96,60]" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <Label id="status" translation="[96,150]" width="1700" wrap="true" color="0xA8A8A8FF" font="font:MediumSystemFont" />
    <MarkupList id="list" translation="[96,220]" itemComponentName="EpisodeItem" itemSize="[1300,200]" itemSpacing="[0,16]" numRows="4"
      vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
  </children>
  <script type="text/brightscript" uri="NotificationsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
