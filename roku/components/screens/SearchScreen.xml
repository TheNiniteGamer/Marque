<?xml version="1.0" encoding="utf-8"?>
<!-- Search: a keyboard on the left, results on the right as you type. -->
<component name="SearchScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" />
  </interface>
  <children>
    <Label text="Search" translation="[96,60]" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <MiniKeyboard id="keyboard" translation="[96,180]" />
    <Label id="status" translation="[760,180]" width="1060" wrap="true" color="0xA8A8A8FF" font="font:MediumSystemFont" text="Type a title, a genre or an episode name." />
    <MarkupGrid id="results" translation="[760,240]" itemComponentName="CardItem" numColumns="3" numRows="4" itemSize="[340,191]" itemSpacing="[16,24]"
      vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="true" />
    <Timer id="typing" duration="0.6" repeat="false" />
  </children>
  <script type="text/brightscript" uri="SearchScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
