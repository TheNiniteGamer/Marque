<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, as on the Android TV app: who's watching, and how things play (saved with your account,
     so other devices follow them; subtitles by default is for this Roku). Everything else is in
     Marquee on a phone or computer. -->
<component name="SettingsScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" />
  </interface>
  <children>
    <Label text="Settings" translation="[96,60]" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <LabelList id="list" translation="[96,190]" itemSize="[1300,76]" numRows="10" color="0xE6E6E6FF" focusedColor="0x000000FF"
      focusBitmapUri="pkg:/images/pill.9.png" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" />
    <Label id="note" translation="[96,980]" width="1728" wrap="true" color="0x8C8C8CFF" font="font:SmallSystemFont" />
    <OptionsMenu id="menu" />
  </children>
  <script type="text/brightscript" uri="SettingsScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
