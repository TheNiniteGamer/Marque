<?xml version="1.0" encoding="utf-8"?>
<!-- The player, in the style of the big streaming apps: OK pauses, the arrows scrub with preview
     pictures, Down reaches Episodes / Audio & Subtitles / Next Episode, Skip Intro during the intro,
     and a Next Episode countdown at the credits. -->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" />

    <Poster id="spinner" uri="pkg:/images/pl_spinner.png" translation="[912,492]" width="96" height="96" scaleRotateCenter="[48,48]" />
    <Animation id="spin" duration="1" repeat="true" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="spinner.rotation" />
    </Animation>

    <!-- Controls: shown on any key, hidden after a few seconds of playing -->
    <Group id="overlay" visible="false">
      <Poster uri="pkg:/images/fade_top.png" width="1920" height="320" />
      <Poster uri="pkg:/images/fade_bottom_player.png" translation="[0,660]" width="1920" height="420" />
      <Label id="heading" translation="[96,64]" width="1500" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="44" /></Label>
      <Label id="subheading" translation="[96,128]" width="1500" color="0xD0D0D0FF" font="font:MediumSystemFont" />
      <Poster id="bigPlay" uri="pkg:/images/pl_play.png" translation="[888,468]" width="144" height="144" opacity="0.85" visible="false" />

      <Group id="preview" visible="false">
        <Rectangle id="previewFrame" color="0xFFFFFFFF" />
        <Group id="previewClip" translation="[3,3]">
          <Poster id="previewSheet" />
        </Group>
        <Label id="previewTime" color="0xFFFFFFFF" horizAlign="center" font="font:MediumBoldSystemFont" />
      </Group>

      <Group id="bar" translation="[96,880]">
        <Rectangle id="track" width="1560" height="8" color="0xFFFFFF50" />
        <Rectangle id="played" width="0" height="8" color="0xE31B23FF" />
        <Poster id="knob" uri="pkg:/images/pl_knob.png" width="32" height="32" translation="[-16,-12]" />
        <Label id="remaining" translation="[1584,-16]" width="144" horizAlign="right" color="0xFFFFFFFF" font="font:MediumSystemFont" />
      </Group>

      <LayoutGroup id="icons" translation="[96,940]" layoutDirection="horiz" itemSpacings="[36]">
        <Poster id="ctlBack" uri="pkg:/images/pl_back10.png" width="64" height="64" scaleRotateCenter="[32,32]" />
        <Poster id="ctlPlay" uri="pkg:/images/pl_pause.png" width="64" height="64" scaleRotateCenter="[32,32]" />
        <Poster id="ctlFwd" uri="pkg:/images/pl_fwd10.png" width="64" height="64" scaleRotateCenter="[32,32]" />
      </LayoutGroup>
      <LayoutGroup id="actions" translation="[1824,952]" layoutDirection="horiz" horizAlignment="right" itemSpacings="[56]" />
    </Group>

    <!-- Skip Intro: OK (or Up) presses it -->
    <Group id="skip" visible="false" translation="[1500,760]">
      <Rectangle width="324" height="76" color="0xFFFFFFFF" />
      <Label text="Skip Intro" width="324" height="76" horizAlign="center" vertAlign="center" color="0x000000FF" font="font:MediumBoldSystemFont" />
    </Group>

    <!-- At the credits: the next episode, starting by itself after a countdown -->
    <Group id="upNext" visible="false" translation="[1180,600]">
      <Rectangle width="644" height="340" color="0x141414F2" />
      <Poster id="nextThumb" translation="[28,28]" width="256" height="144" loadWidth="256" loadHeight="144" loadDisplayMode="scaleToZoom" />
      <Label id="nextKind" translation="[308,30]" width="310" color="0xA8A8A8FF" font="font:SmallBoldSystemFont" />
      <Label id="nextTitle" translation="[308,66]" width="310" wrap="true" maxLines="3" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
      <Group id="nextBtn0" translation="[28,204]">
        <Rectangle id="nextBg0" width="588" height="48" />
        <Label id="nextText0" width="588" height="48" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" />
      </Group>
      <Group id="nextBtn1" translation="[28,264]">
        <Rectangle id="nextBg1" width="588" height="48" />
        <Label id="nextText1" width="588" height="48" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" />
      </Group>
    </Group>

    <!-- Paused for a while: what you're watching -->
    <Group id="idle" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000B0" />
      <Label text="You're watching" translation="[160,330]" color="0xA8A8A8FF" font="font:MediumSystemFont" />
      <Label id="idleTitle" translation="[160,380]" width="1400" wrap="true" maxLines="2" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="64" /></Label>
      <Label id="idleSub" translation="[160,560]" width="1400" color="0xDEDEDEFF" font="font:MediumBoldSystemFont" />
      <Label id="idleOverview" translation="[160,620]" width="1100" wrap="true" maxLines="4" color="0xC8C8C8FF" font="font:MediumSystemFont" />
    </Group>

    <!-- Audio & Subtitles -->
    <Group id="panel" visible="false">
      <Rectangle width="1920" height="1080" color="0x00000080" />
      <Rectangle translation="[1040,0]" width="880" height="1080" color="0x141414F5" />
      <Label text="Audio" translation="[1100,110]" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
      <RadioButtonList id="audioList" translation="[1100,180]" itemSize="[380,64]" vertFocusAnimationStyle="floatingFocus" numRows="12"
        color="0xC8C8C8FF" focusedColor="0x000000FF" focusBitmapUri="pkg:/images/white.png" font="font:SmallSystemFont" focusedFont="font:SmallBoldSystemFont" />
      <Label text="Subtitles" translation="[1500,110]" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
      <RadioButtonList id="subList" translation="[1500,180]" itemSize="[380,64]" vertFocusAnimationStyle="floatingFocus" numRows="12"
        color="0xC8C8C8FF" focusedColor="0x000000FF" focusBitmapUri="pkg:/images/white.png" font="font:SmallSystemFont" focusedFont="font:SmallBoldSystemFont" />
    </Group>

    <Label id="message" translation="[160,480]" width="1600" wrap="true" horizAlign="center" color="0xFFFFFFFF" font="font:MediumSystemFont" />

    <Timer id="reportTimer" duration="10" repeat="true" />
    <Timer id="hideTimer" duration="5" />
    <Timer id="holdTimer" duration="0.25" repeat="true" />
    <Timer id="commitTimer" duration="0.9" />
    <Timer id="idleTimer" duration="12" />
    <Timer id="countTimer" duration="1" repeat="true" />
  </children>
  <script type="text/brightscript" uri="PlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
