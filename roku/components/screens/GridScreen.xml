<?xml version="1.0" encoding="utf-8"?>
<!-- A grid of titles with the top bar (this page in bold): a whole library (with sorting, All /
     Unwatched and a genre, as on the web), My List, a collection or franchise, or the titles an
     actor is in. -->
<component name="GridScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" onChange="onRefresh" />
  </interface>
  <children>
    <TopBar id="topBar" />
    <Label id="title" translation="[96,130]" width="1300" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <Label id="count" translation="[96,212]" width="1700" wrap="true" maxLines="2" color="0xA8A8A8FF" font="font:SmallSystemFont" />
    <ButtonRow id="filters" translation="[96,196]" visible="false" />
    <MarkupGrid id="grid" translation="[96,300]" itemComponentName="CardItem" numColumns="4" numRows="3" itemSize="[420,236]" itemSpacing="[16,28]"
      vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="true" />
    <OptionsMenu id="menu" />
  </children>
  <script type="text/brightscript" uri="GridScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
