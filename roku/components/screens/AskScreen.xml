<?xml version="1.0" encoding="utf-8"?>
<!-- "Ask for it", from Search: films or shows found online with that name; choosing one asks for it
     (as on the web). Ones already here open; ones asked for already can be joined ("Me too"). -->
<component name="AskScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams" />
    <field id="navigate" type="assocarray" />
    <field id="refresh" type="boolean" />
  </interface>
  <children>
    <Label id="title" translation="[96,60]" width="1700" color="0xFFFFFFFF"><Font role="font" uri="pkg:/fonts/Archivo-Black.ttf" size="56" /></Label>
    <ButtonRow id="kinds" translation="[96,160]" />
    <Label id="status" translation="[96,260]" width="1700" wrap="true" maxLines="2" color="0xA8A8A8FF" font="font:MediumSystemFont" />
    <MarkupList id="results" translation="[96,330]" itemComponentName="EpisodeItem" itemSize="[1300,200]" itemSpacing="[0,16]" numRows="4"
      vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
  </children>
  <script type="text/brightscript" uri="AskScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
</component>
