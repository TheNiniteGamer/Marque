        <field id="buttons" type="array" onChange="build" />
        <field id="selected" type="integer" alwaysNotify="true" />
        <field id="index" type="integer" value="0" onChange="paint" />
        <field id="rest" type="integer" value="0" onChange="paint" />
    </interface>
    <script type="text/brightscript" uri="ButtonRow.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <LayoutGroup id="row" layoutDirection="horiz" itemSpacings="[16]" />
    </children>
</component>
