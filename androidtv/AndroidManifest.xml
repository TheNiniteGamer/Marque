<?xml version="1.0" encoding="utf-8"?>
<!-- Marquee for Android TV. The code and most resources are the phone app's (../android); this
     manifest adds the TV launcher entry and banner, and doesn't require a touch screen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.marquee.tv">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updating itself from the Marquee server (Account → Check for updates) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Continue Watching on the TV's home screen -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.Marquee"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name="app.marquee.client.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- "Hey Google, search Marquee for …" -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.marquee.client.ServerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name="app.marquee.client.PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.Marquee.Player"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation" />
        <!-- Android's package installer answering about an update (Updater) -->
        <receiver
            android:name="app.marquee.client.UpdateReceiver"
            android:exported="false" />
        <!-- Pictures for Continue Watching on the TV's home screen -->
        <provider
            android:name="app.marquee.client.ArtProvider"
            android:authorities="app.marquee.tv.art"
            android:exported="true" />
    </application>
</manifest>
