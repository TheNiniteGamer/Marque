<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/subs"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/subs_bg"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:shadowColor="#FF000000"
        android:shadowRadius="3"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <Button
        android:id="@+id/skip_intro"
        style="@style/SkipIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="110dp"
        android:text="@string/skip_intro"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <ImageButton
                android:id="@+id/back"
                style="@style/PlayerIcon"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#FFBBBBBB"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/pip"
                style="@style/PlayerIcon"
                android:contentDescription="Picture-in-picture"
                android:src="@drawable/ic_pip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="36dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/accent"
                android:secondaryProgressTint="#88FFFFFF"
                android:thumbTint="@color/accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/play_pause"
                    style="@style/PlayerIcon"
                    android:contentDescription="Play or pause"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/rewind"
                    style="@style/PlayerIcon"
                    android:contentDescription="Back 10 seconds"
                    android:src="@drawable/ic_rewind" />

                <ImageButton
                    android:id="@+id/forward"
                    style="@style/PlayerIcon"
                    android:contentDescription="Forward 30 seconds"
                    android:src="@drawable/ic_forward" />

                <TextView
                    android:id="@+id/time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFDDDDDD"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/subs_btn"
                    style="@style/PlayerIcon"
                    android:contentDescription="@string/subtitles"
                    android:src="@drawable/ic_subtitles" />

                <ImageButton
                    android:id="@+id/audio"
                    style="@style/PlayerIcon"
                    android:contentDescription="@string/audio"
                    android:src="@drawable/ic_audio" />

                <ImageButton
                    android:id="@+id/quality"
                    style="@style/PlayerIcon"
                    android:contentDescription="@string/quality"
                    android:src="@drawable/ic_quality"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/speed"
                    style="@style/PlayerIcon"
                    android:contentDescription="@string/speed"
                    android:src="@drawable/ic_speed" />

                <ImageButton
                    android:id="@+id/next"
                    style="@style/PlayerIcon"
                    android:contentDescription="Next episode"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
