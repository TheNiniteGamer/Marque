<?xml version="1.0" encoding="utf-8"?>
<!-- The player, laid out like the big streaming apps (and Marquee's Roku channel), on phones and
     TVs alike (sizes: values/ and values-television/dimens.xml). On a TV, OK pauses, the arrows
     scrub with preview pictures and Down reaches the buttons; nothing here takes focus, as
     PlayerControls handles the keys and draws the highlight. On a phone, everything is tapped. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:descendantFocusability="blocksDescendants">

    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/subs"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="@dimen/player_subs_bottom"
        android:background="@drawable/subs_bg"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:shadowColor="#FF000000"
        android:shadowRadius="3"
        android:textColor="@android:color/white"
        android:textSize="@dimen/player_subs" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <!-- Controls: shown on any key, hidden after a few seconds of playing -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/player_side"
            android:paddingTop="@dimen/player_top"
            android:paddingEnd="@dimen/player_side"
            android:paddingBottom="48dp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                android:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/player_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFD0D0D0"
                android:textSize="@dimen/player_subtitle" />
            </LinearLayout>

            <ImageView
                android:id="@+id/pip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Picture-in-picture"
                android:padding="10dp"
                android:src="@drawable/ic_pip"
                android:tint="@android:color/white" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tv_big_play"
            android:layout_width="@dimen/player_big_play"
            android:layout_height="@dimen/player_big_play"
            android:layout_gravity="center"
            android:alpha="0.85"
            android:src="@drawable/tv_play"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/player_side"
            android:paddingTop="48dp"
            android:paddingEnd="@dimen/player_side"
            android:paddingBottom="@dimen/player_bottom">

            <!-- The preview picture while scrubbing (moved along above the bar) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/tv_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/tv_preview_img"
                        android:layout_width="@dimen/player_preview_w"
                        android:layout_height="@dimen/player_preview_h"
                        android:background="@drawable/tv_frame"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tv_preview_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tv_track"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:clipChildren="false">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_gravity="center_vertical"
                        android:background="#55FFFFFF" />

                    <View
                        android:id="@+id/tv_played"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/accent" />

                    <View
                        android:id="@+id/tv_knob"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/tv_knob" />
                </FrameLayout>

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:minWidth="72dp"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/player_time" />
            </LinearLayout>

            <!-- Episodes on the left · back 10, play/pause, ahead 10 in the middle · the rest on the right -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:minHeight="@dimen/player_row">

                <LinearLayout
                    android:id="@+id/tv_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/rewind"
                        android:layout_width="@dimen/player_icon"
                        android:layout_height="@dimen/player_icon"
                        android:padding="6dp"
                        android:src="@drawable/tv_back10" />

                    <ImageView
                        android:id="@+id/play_pause"
                        android:layout_width="@dimen/player_icon"
                        android:layout_height="@dimen/player_icon"
                        android:layout_marginStart="@dimen/player_icon_gap"
                        android:layout_marginEnd="@dimen/player_icon_gap"
                        android:padding="6dp"
                        android:src="@drawable/tv_pause" />

                    <ImageView
                        android:id="@+id/forward"
                        android:layout_width="@dimen/player_icon"
                        android:layout_height="@dimen/player_icon"
                        android:padding="6dp"
                        android:src="@drawable/tv_fwd10" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tv_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Skip Intro / Skip Credits: OK (or Up) presses it -->
    <Button
        android:id="@+id/skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/player_side"
        android:layout_marginBottom="@dimen/player_skip_bottom"
        android:background="@drawable/tv_pill_on"
        android:minHeight="52dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/skip_intro"
        android:textAllCaps="false"
        android:textColor="#FF000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- At the credits: the next episode, starting by itself after a countdown -->
    <LinearLayout
        android:id="@+id/tv_upnext"
        android:layout_width="@dimen/player_card_w"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/player_side"
        android:layout_marginBottom="@dimen/player_bottom"
        android:background="@drawable/tv_card"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tv_next_thumb"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:background="#FF262626"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_next_kind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:textColor="#FFA8A8A8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_next_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_next_btn0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_next_btn1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Paused for a while: what you're watching -->
    <LinearLayout
        android:id="@+id/tv_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B0000000"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingEnd="300dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/youre_watching"
            android:textColor="#FFA8A8A8"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_idle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_idle_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFDEDEDE"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_idle_overview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="#FFC8C8C8"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Audio & Subtitles (and Quality when the server offers it) -->
    <FrameLayout
        android:id="@+id/tv_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#F5141414"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tv_panel_cols"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingTop="@dimen/player_top"
                android:paddingEnd="28dp" />
        </HorizontalScrollView>
    </FrameLayout>
</FrameLayout>
